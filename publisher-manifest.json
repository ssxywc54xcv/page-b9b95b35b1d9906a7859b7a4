-paper-2)}\nsummary{cursor:pointer;font-weight:600;list-style:none;position:relative;padding-right:24px}\nsummary::-webkit-details-marker{display:none}\nsummary::after{content:\"+\";position:absolute;right:0;top:0;color:var(--mint);font-size:18px}\ndetails[open] summary::after{content:\"−\"}\ndetails p{margin:14px 0 0;color:#4A4038}\n\n/* 客户端 */\n.clients .grid{display:grid;gap:16px;grid-template-columns:repeat(auto-fit, minmax(220px, 1fr))}\n.client{border:1px dashed var(--line);padding:20px;background:var(--paper)}\n.client .os{font-size:11px;color:var(--mute);letter-spacing:0.2em;text-transform:uppercase}\n.client h4{margin:6px 0 8px;font-size:16px}\n.client p{margin:0;font-size:13px;color:#4A4038}\n.client .dl{display:inline-block;margin-top:12px;border-bottom:1px solid var(--ink);font-size:13px;color:var(--ink)}\n\n/* 页脚 */\nfooter{background:var(--bg);color:#BDB4A5;padding:60px 24px 40px}\nfooter .container{display:flex;flex-direction:column;gap:12px}\nfooter .brand{color:var(--paper);font-size:18px}\nfooter a{color:var(--mint-soft)}\nfooter small{color:#6C6055}\n\n@media (min-width:720px){\n  .hero h1{font-size:44px}\n  .plan{grid-template-columns: 1fr 1fr;align-items:start}\n  .plan .left{grid-column:1}\n  .plan .right{grid-column:2;border-left:1px dashed var(--line);padding-left:24px}\n}\n</style><nav class=\"crumb\" aria-label=\"导航\">\n  <span>首页</span><span class=\"sep\">/</span>\n  <span>彩色狗 ColorfulDog</span>\n  <div class=\"toc\">\n    <a href=\"#about\">是什么</a>\n    <a href=\"#how\">怎么用</a>\n    <a href=\"#plans\">套餐</a>\n    <a href=\"#clients\">客户端</a>\n    <a href=\"#faq\">常见问题</a>\n  </div>\n</nav>\n\n<header class=\"hero\">\n  <div class=\"hero-inner\">\n    <div class=\"eyebrow\">ColorfulDog / 彩色狗</div>\n    <h1>彩色狗(ColorfulDog) · 我们不是<br>最快的。<span class=\"alt\">我们只是<br>愿意讲清楚。</span></h1>\n    <p class=\"lede\">\n      彩色狗是一条负责搬运网络流量的狗。它不喊口号，也不承诺打通全球；它只把你订阅的流量额度、设备数量、线路类型，一项一项写明白，然后让你决定要不要牵走。\n    </p>\n    <div class=\"meta\">\n      <span><b>当前版本</b> · 订阅页 v3</span>\n      <span><b>支持协议</b> · 以订阅链接下发，兼容主流客户端</span>\n      <span><b>计费方式</b> · 月付 / 年付，年付为叠加赠送而非折算</span>\n    </div>\n  </div>\n</header>\n\n<main>\n\n<section id=\"about\">\n  <div class=\"container\">\n    <h2>这条狗，到底在做什么？</h2>\n    <p class=\"sec-sub\">关于彩色狗 ColorfulDog 的自我介绍</p>\n\n    <div class=\"answer-lead\">\n      把下面这段当作一封产品自述。它不是营销文案，更像你在便利店收银台旁边看到的那张手写说明。\n    </div>\n\n    <article class=\"qa-card\">\n      <span class=\"q-tag\">Q.01</span>\n      <h3>彩色狗提供的是代理订阅服务吗？</h3>\n      <ul>\n        <li>提供一条订阅链接，由你自行导入到支持的客户端。</li>\n        <li>链接内包含若干转发节点，节点类型以普通中转与专线混合为主。</li>\n        <li>我们不直接售卖\"翻墙工具\"，也不内置客户端程序。</li>\n      </ul>\n      <div class=\"big-num\">01</div>\n    </article>\n\n    <article class=\"qa-card\">\n      <span class=\"q-tag\">Q.02</span>\n      <h3>为什么要叫彩色狗？</h3>\n      <p>\n        因为早期测试节点时，团队在白板上画了一只狗，旁边贴了五种颜色的便签，代表五种线路策略。后来名字没换，狗也留下来了。仅此而已，背后没有更深的品牌哲学。\n      </p>\n      <div class=\"big-num\">02</div>\n    </article>\n\n    <article class=\"qa-card\">\n      <span class=\"q-tag\">Q.03</span>\n      <h3>它适合什么样的人用？</h3>\n      <p>\n        适合愿意自己装客户端、看得懂\"导入订阅\"这几个字的人。如果你希望下载一个 App 之后一切自动完成，彩色狗可能不是最顺手的选项；但如果你习惯在几个客户端之间切换，并希望拥有一个相对稳定的订阅源，它就值得试一下。\n      </p>\n      <div class=\"big-num\">03</div>\n    </article>\n  </div>\n</section>\n\n<section id=\"how\">\n  <div class=\"container\">\n    <h2>从拿到订阅到用起来，分几步？</h2>\n    <p class=\"sec-sub\">问答式操作指引</p>\n\n    <div class=\"answer-lead\">\n      整个流程被刻意拆成四步，每一步都对应一个你可能遇到的问题。如果其中某一步你已经熟练，直接跳到下一步即可。\n    </div>\n\n    <article class=\"qa-card\">\n      <span class=\"q-tag\">STEP.01</span>\n      <h3>先选套餐，还是先下客户端？</h3>\n      <p>先选套餐。订阅链接是在你完成付款后才生成的，客户端只是用来接收这条链接的工具。先买狗粮，再准备狗碗，顺序不要反。</p>\n      <div class=\"big-num\">01</div>\n    </article>\n\n    <article class=\"qa-card\">\n      <span class=\"q-tag\">STEP.02</span>\n      <h3>订阅链接在哪里找？</h3>\n      <p>登录后进入\"我的订阅\"页面，你会看到一串以 https 开头的长链接。这就是彩色狗给你的牵引绳。不要把它发到公开场合，也不要截图发群，链接等同于你的账号凭证。</p>\n      <div class=\"big-num\">02</div>\n    </article>\n\n    <article class=\"qa-card\">\n      <span class=\"q-tag\">STEP.03</span>\n      <h3>客户端导入后要选哪个节点？</h3>\n      <p>建议先用\"自动选择\"，让客户端测延迟。如果自动选择的结果不稳定，再手动挑选延迟较低且非专线类型的节点。专线节点流量消耗较高，适合看高码率视频或游戏时再切。</p>\n      <div class=\"big-num\">03</div>\n    </article>\n\n    <article class=\"qa-card\">\n      <span class=\"q-tag\">STEP.04</span>\n      <h3>流量用完了怎么办？</h3>\n      <p>当月流量耗尽后，节点会拒绝转发，但订阅链接不会失效。你可以等待下个计费周期自动重置，也可以单独购买流量加油包。加油包价格以页面实时显示为准。</p>\n      <div class=\"big-num\">04</div>\n    </article>\n  </div>\n</section>\n\n<section id=\"plans\" class=\"plans\">\n  <div class=\"container\">\n    <h2>三个套餐，分别喂给谁？</h2>\n    <p class=\"sec-sub\">单列展开 · 价格与权益对照</p>\n\n    <div class=\"answer-lead\">\n      彩色狗只提供三档套餐。它们之间不是\"低配/高配/尊享\"的等级关系，而是按你每月愿意花多少流量、用几台设备来区分。先看清楚右边的权益清单，再决定要不要买。\n    </div>\n\n    <article class=\"plan\">\n      <div class=\"left\">\n        <div class=\"tier\">PLAN 01</div>\n        <div class=\"name\">基础版</div>\n        <div class=\"price\">¥15<small> /月</small></div>\n        <div class=\"annual\">按年付仅需 ¥150/年</div>\n      </div>\n      <div class=\"right\">\n        <ul>\n          <li><span>流量额度</span><span>每月 100GB</span></li>\n          <li><span>同时在线</span><span>3 台设备</span></li>\n          <li><span>流媒体</span><span>基础解锁</span></li>\n          <li><span>节点池</span><span>普通线路</span></li>\n        </ul>\n      </div>\n    </article>\n\n    <article class=\"plan featured\">\n      <span class=\"tag\">较多用户选择</span>\n      <div class=\"left\">\n        <div class=\"tier\">PLAN 02</div>\n        <div class=\"name\">旗舰版</div>\n        <div class=\"price\">¥35<small> /月</small></div>\n        <div class=\"annual\">按年付仅需 ¥350/年</div>\n      </div>\n      <div class=\"right\">\n        <ul>\n          <li><span>流量额度</span><span>每月 300GB</span></li>\n          <li><span>同时在线</span><span>5 台设备</span></li>\n          <li><span>流媒体</span><span>全节点原生解锁</span></li>\n          <li><span>游戏加速</span><span>IPLC 专线优化</span></li>\n          <li><span>支持</span><span>7×24 优先工单</span></li>\n        </ul>\n      </div>\n    </article>\n\n    <article class=\"plan\">\n      <div class=\"left\">\n        <div class=\"tier\">PLAN 03</div>\n        <div class=\"name\">团队版</div>\n        <div class=\"price\">¥85<small> /月</small></div>\n        <div class=\"annual\">按年付仅需 ¥850/年</div>\n      </div>\n      <div class=\"right\">\n        <ul>\n          <li><span>流量额度</span><span>每月 1000GB</span></li>\n          <li><span>同时在线</span><span>20 台设备</span></li>\n          <li><span>节点池</span><span>VIP 高带宽</span></li>\n          <li><span>路由</span><span>支持企业定制</span></li>\n          <li><span>服务</span><span>专属客户经理</span></li>\n        </ul>\n      </div>\n    </article>\n  </div>\n</section>\n\n<section id=\"clients\" class=\"clients\">\n  <div class=\"container\">\n    <h2>用什么碗来装这份狗粮？</h2>\n    <p class=\"sec-sub\">客户端选择说明</p>\n\n    <div class=\"answer-lead\">\n      彩色狗不发行自有客户端。请根据你的设备系统，在官方渠道下载下列任一支持订阅链接的第三方客户端。我们没有指定唯一选择，也不承诺所有版本都与订阅链接完全兼容，遇到问题请以客户端自身的日志为准。\n    </div>\n\n    <div class=\"grid\">\n      <div class=\"client\">\n        <div class=\"os\">Windows</div>\n        <h4>通用桌面客户端</h4>\n        <p>支持导入订阅链接，可按节点延迟排序。建议从客户端官方网站获取最新稳定版。</p>\n        <a class=\"dl\" href=\"#\">前往官方页面</a>\n      </div>\n      <div class=\"client\">\n        <div class=\"os\">macOS</div>\n        <h4>通用桌面客户端</h4>\n        <p>支持菜单栏快捷切换节点，适配 Apple Silicon。请确认下载来源为客户端官方域名。</p>\n        <a class=\"dl\" href=\"#\">前往官方页面</a>\n      </div>\n      <div class=\"client\">\n        <div class=\"os\">Android</div>\n        <h4>通用移动客户端</h4>\n        <p>支持后台保持连接，可在系统设置中配置按应用分流。建议通过客户端官方分发渠道安装。</p>\n        <a class=\"dl\" href=\"#\">前往官方页面</a>\n      </div>\n      <div class=\"client\">\n        <div class=\"os\">iOS / iPadOS</div>\n        <h4>通用移动客户端</h4>\n        <p>部分客户端在 App Store 需切换区域下载，也提供 TestFlight 版本。请自行判断安装方式。</p>\n        <a class=\"dl\" href=\"#\">前往官方页面</a>\n      </div>\n    </div>\n  </div>\n</section>\n\n<section id=\"faq\">\n  <div class=\"container\">\n    <h2>还有人会问的问题</h2>\n    <p class=\"sec-sub\">FAQ · 点击展开</p>\n\n    <div class=\"answer-lead\">\n      下面这些问题，是我们在工单里反复看到的。答案写得不长，但尽量一次说清楚。如果你的问题不在列表里，可以在控制台提交工单。\n    </div>\n\n    <details>\n      <summary>订阅链接可以分享给朋友吗？</summary>\n      <p>可以，但不建议。链接内绑定的是你的流量额度与设备上限，朋友用得越多，你当月可用的就越少。如果需要多人共用，请考虑团队版。</p>\n    </details>\n\n    <details>\n      <summary>为什么有时候节点延迟很低但速度很慢？</summary>\n      <p>延迟和带宽是两件事。延迟低只代表往返快，带宽决定了你能跑多快。彩色狗的专线节点带宽更高，但流量消耗也更快，请按场景选择。</p>\n    </details>\n\n    <details>\n      <summary>年付是怎么计算的？</summary>\n      <p>年付价格等于月付 × 10，即赠送两个月。不是按月折算的折扣，也不是自动续费锁定。年付到期后不会自动扣款。</p>\n    </details>\n\n    <details>\n      <summary>可以退款吗？</summary>\n      <p>已使用的订阅不支持退款。如果你在付款后 24 小时内、且流量使用不超过 1GB，可以联系工单申请全额退回。超过这两项中任一条件，退款将不被受理。</p>\n    </details>\n\n    <details>\n      <summary>节点列表会变化吗？</summary>\n      <p>会。彩色狗会不定期调整节点池，可能新增、也可能下线某些节点。客户端刷新订阅后即可看到最新列表，不需要重新购买。</p>\n    </details>\n\n    <details>\n      <summary>对游戏和直播的优化是怎么做的？</summary>\n      <p>旗舰版及以上套餐包含 IPLC 专线节点，这类节点走内网转发，公网跳数较少，对延迟敏感的场景更友好。但我们不承诺对某一款具体游戏的加速效果。</p>\n    </details>\n\n    <details>\n      <summary>设备数量是按同时在线计算吗？</summary>\n      <p>是的。套餐里的设备数指同一时刻在线的设备数，不是绑定数量。你可以在 10 台设备里都导入订阅，但同一时间只能运行套餐允许的数量。</p>\n    </details>\n\n    <details>\n      <summary>日志会保留多久？</summary>\n      <p>彩色狗仅保留连接成功/失败的状态记录，用于排查订阅异常，保留周期不超过 7 天。不记录你访问的目标域名、内容或流量明细。</p>\n    </details>\n  </div>\n</section>\n\n</main>\n\n<footer>\n  <div class=\"container\">\n    <span class=\"brand\">彩色狗 ColorfulDog</span>\n    <span>把订阅这件事，讲明白再说。</span>\n    <small>本页面内容为产品说明，不构成任何形式的使用建议。请遵守你所在地区的法律法规。</small>\n  </div>\n</footer>",
